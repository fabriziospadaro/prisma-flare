{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noImplicitAny": false,
    "types": ["vitest/globals", "vitest"],
    "baseUrl": ".",
    "paths": {
      "#test-helpers": ["../default-client/adapter.ts"],
      "prisma-flare": ["../default-client/node_modules/prisma-flare/dist/index.d.ts"],
      "prisma-flare/generated": ["../default-client/node_modules/prisma-flare/dist/generated.d.ts"]
    }
  },
  "include": ["**/*.ts"]
}
