{
  "name": "prisma-flare",
  "version": "1.2.6",
  "description": "Prisma utilities package with callback system and query builder for chained operations",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check": "tsx scripts/check-types.ts",
    "lint": "eslint src --ext .ts --fix && prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build",
    "preuninstall": "node ./dist/cli/uninstall.js || true",
    "test": "tsx scripts/setup-tests.ts && tsx scripts/run-tests.ts",
    "test:watch": "cd tests/default-client && npx vitest"
  },
  "keywords": [
    "prisma",
    "orm",
    "utilities",
    "callbacks",
    "query-builder",
    "middleware",
    "hooks",
    "typescript"
  ],
  "author": "Fabrizio Spadaro",
  "license": "MIT",
  "bin": {
    "prisma-flare": "./dist/cli/index.js"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.18.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": false
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "expect-type": "^1.3.0",
    "prettier": "^3.7.4",
    "prisma": "^5.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js",
      "require": "./dist/generated.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client/index.d.ts"
      ],
      "generated": [
        "./dist/generated.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
